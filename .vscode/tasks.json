{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lilypond",
            "type": "process",
            "command": "/opt/lilypond-2.26.0/bin/lilypond",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build"
        },
        {
            "label": "Save",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/save.py"
            ],
            "group": "build"
        },
        {   
            "label": "New",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/new.py"
            ],
            "group": "build"
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/install.py",
                "--code"
            ],
            "group": "build"
        },
        {
            "label": "Frescobaldi",
            "type": "process",
            "command": "flatpak",
            "args": [
                "run",
                "org.frescobaldi.Frescobaldi",
                "${file}"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": "build"
        },
        {
            "label": "Lecteur midi",
            "type": "shell",
            "command": "timidity",
            "args": [
                "${fileDirname}/${fileBasenameNoExtension}.midi"
            ],
            "group": "build"
        },
        {
            "label": "Clean LaTeX",
            "type": "shell",
            "command": "find \"${fileDirname}\" -maxdepth 1 -type f \\( -name '*.aux' -o -name '*.gaux' -o -name '*.log' -o -name '*.out' -o -name '*.toc' -o -name '*.synctex.gz' -o -name '*.fdb_latexmk' -o -name '*.fls' \\) -delete && rm -rf \"${fileDirname}/tmp-gre\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build"
        },
        {
            "label": "Gregorio",
            "type": "shell",
            "command": "gregorio",
            "args": [
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build"
        }
    ]
}