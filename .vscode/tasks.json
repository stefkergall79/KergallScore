{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lilypond",
            "type": "process",
            "command": "/opt/lilypond-2.26.0/bin/lilypond",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build"
        },
        {
            "label": "Save",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/save.py"
            ],
            "group": "build"
        },
        {
            "label": "New",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/new.py"
            ],
            "group": "build"
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/install.py",
                "--code"
            ],
            "group": "build"
        },
        {
            "label": "Frescobaldi",
            "type": "process",
            "command": "flatpak",
            "args": [
                "run",
                "org.frescobaldi.Frescobaldi",
                "${file}"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": "build"
        },
        {
            "label": "Timidity++",
            "type": "shell",
            "command": "timidity",
            "args": [
                "${fileDirname}/${fileBasenameNoExtension}.midi"
            ],
            "group": "build"
        }
    ]
}